; Engine configuration file.
; Circuit Bastion Godot 4 desktop vertical slice.
config_version=5

[application]

config/name="Circuit Bastion"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

AudioFeedback="*res://scripts/audio_feedback.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

toggle_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
speed_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194322,"unicode":0)]
}
lock_wave={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":76,"unicode":108)]
}

[display/window]

handheld/orientation=1
